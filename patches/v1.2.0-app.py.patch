+WEB_CONTAINER_PORTS = {
+    80, 443, 3000, 4000, 4173, 5000, 5173, 8000, 8080, 8081,
+    8096, 8123, 8443, 8888, 9000, 9080, 1997,
+}
+NON_WEB_CONTAINER_PORTS = {
+    22, 25, 53, 110, 143, 465, 587, 993, 995,
+    3306, 5432, 5672, 6379, 11211, 27017,
+}
+
+
+def parse_container_port_number(container_port):
+    text = str(container_port or "").split("/", 1)[0]
+    try:
+        return int(text)
+    except (TypeError, ValueError):
+        return None
+
+
+def published_bindings(c):
+    result = []
+    if not c.ports:
+        return result
+    for container_port, bindings in c.ports.items():
+        if not bindings:
+            continue
+        cport = parse_container_port_number(container_port)
+        for binding in bindings:
+            host_port = binding.get("HostPort")
+            if not host_port:
+                continue
+            try:
+                hport = int(host_port)
+            except (TypeError, ValueError):
+                continue
+            result.append({
+                "host_ip": binding.get("HostIp") or "0.0.0.0",
+                "host_port": hport,
+                "container_port": cport,
+            })
+    return result
+
+
+def pick_open_binding(bindings):
+    if not bindings:
+        return None
+    unique = []
+    seen = set()
+    for binding in bindings:
+        port = binding["host_port"]
+        if port in seen:
+            continue
+        seen.add(port)
+        unique.append(binding)
+
+    def score(binding):
+        cport = binding.get("container_port")
+        hport = binding["host_port"]
+        web = (cport in WEB_CONTAINER_PORTS) or (hport in WEB_CONTAINER_PORTS)
+        skip = (cport in NON_WEB_CONTAINER_PORTS) or (hport in NON_WEB_CONTAINER_PORTS)
+        if web:
+            return (0, hport)
+        if skip:
+            return (2, hport)
+        return (1, hport)
+
+    unique.sort(key=score)
+    return unique[0]
+
